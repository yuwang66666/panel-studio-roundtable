{
  "name": "ai-panel-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm --filter @panel/api dev\" \"pnpm --filter @panel/web dev\"",
    "build": "pnpm --filter @panel/web build && pnpm typecheck",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "pnpm --filter @panel/api seed",
    "db:init": "pnpm --filter @panel/api db:init",
    "docs:samples": "tsx scripts/export-samples.ts && prettier --write docs/samples.md",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:layout": "playwright test --config playwright.layout.config.ts",
    "format": "prettier --write apps packages tests scripts docs *.json *.ts *.yaml README.md",
    "format:check": "prettier --check apps packages tests scripts docs *.json *.ts *.yaml README.md",
    "verify:clean": "node scripts/verify-clean.mjs",
    "docs:api": "pnpm --filter @panel/api docs:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.21.0",
    "zod": "^3.25.76",
    "prettier": "^3.8.1"
  },
  "type": "module"
}
