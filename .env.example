API_PORT=3001
WEB_PORT=5173
# DATA_DIR 默认是仓库 .data 目录；自定义时填写绝对路径。
MAX_CONCURRENT_DISCUSSIONS=3
MODEL_CONCURRENCY=4
CONNECTION_CONCURRENCY=2
MODEL_TIMEOUT_MS=60000
SUMMARY_TIMEOUT_MS=90000
# 洞察提炼单独配置：每次尝试最多180秒，最多请求8192个输出token。
INSIGHTS_TIMEOUT_MS=180000
INSIGHTS_MAX_TOKENS=8192
# 允许访问本地后端的网页来源，以逗号分隔。
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 将此文件复制为仓库根目录 .env，再填写实际模型 ID 和 API Key。
# .env 只由后端读取，修改后重启后端生效；网页只选择已配置的模型。
# 下列基础地址和协议是预设，可按实际服务商/中转服务调整。
# MODEL 与 API_KEY 同时为空时跳过该项；仅填写其中一个会导致配置校验失败。
# 含 # 或空格的值必须加引号，例如 API_KEY="your-key#suffix"。
# 不支持 ${变量名} 插值；每个字段都需要填写实际值。
# .env 含明文密钥，已被 Git 忽略；不要把真实凭据填进 .env.example。

# 标识使用大写字母开头，只含大写字母、数字、下划线，最长40字符，不可重复。
# 同一服务商可配置多个模型：复制一整组字段、改用新标识，并追加到此清单。
# 例如 DEEPSEEK_FAST 与 DEEPSEEK_REASONING；标识用于保持连接历史，请勿随意重命名。
PANEL_MODELS=DEEPSEEK,CLAUDE,QWEN,GPT,KIMI

# 可选：填写一个已完整配置的标识，每次启动都会设为默认主持人。
# 留空时保留网页已选择的有效默认模型，否则使用清单中第一个可用模型。
PANEL_DEFAULT_MODERATOR=

MODEL_DEEPSEEK_NAME="DeepSeek"
MODEL_DEEPSEEK_PROVIDER=deepseek
MODEL_DEEPSEEK_PROTOCOL=openai-chat
MODEL_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_DEEPSEEK_MODEL=
MODEL_DEEPSEEK_API_KEY=
MODEL_DEEPSEEK_STRUCTURED_OUTPUT=false

MODEL_CLAUDE_NAME="Claude"
MODEL_CLAUDE_PROVIDER=claude
MODEL_CLAUDE_PROTOCOL=anthropic
MODEL_CLAUDE_BASE_URL=https://api.anthropic.com/v1
MODEL_CLAUDE_MODEL=
MODEL_CLAUDE_API_KEY=
MODEL_CLAUDE_STRUCTURED_OUTPUT=false

MODEL_QWEN_NAME="Qwen"
MODEL_QWEN_PROVIDER=qwen
MODEL_QWEN_PROTOCOL=openai-chat
MODEL_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_QWEN_MODEL=
MODEL_QWEN_API_KEY=
MODEL_QWEN_STRUCTURED_OUTPUT=false

MODEL_GPT_NAME="GPT"
MODEL_GPT_PROVIDER=gpt
MODEL_GPT_PROTOCOL=openai-responses
MODEL_GPT_BASE_URL=https://api.openai.com/v1
MODEL_GPT_MODEL=
MODEL_GPT_API_KEY=
MODEL_GPT_STRUCTURED_OUTPUT=false

MODEL_KIMI_NAME="Kimi"
MODEL_KIMI_PROVIDER=kimi
MODEL_KIMI_PROTOCOL=openai-chat
MODEL_KIMI_BASE_URL=https://api.moonshot.cn/v1
MODEL_KIMI_MODEL=
MODEL_KIMI_API_KEY=
MODEL_KIMI_STRUCTURED_OUTPUT=false
